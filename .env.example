# Copy to .env and set POSTGRES_PASSWORD. Never commit .env.

# Postgres service (docker compose)
POSTGRES_USER=facefit
POSTGRES_DB=facefit
POSTGRES_PASSWORD=

# Backend
# Outside compose, set DATABASE_URL directly. pglite://memory runs Postgres in WASM without Docker.
DATABASE_URL=pglite://memory
PORT=5055
# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Set true only behind one reverse proxy that appends X-Forwarded-For.
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
TELEMETRY_RATE_LIMIT_MAX=30
REQUEST_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=10000
