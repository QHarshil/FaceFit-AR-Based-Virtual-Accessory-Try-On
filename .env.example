# Copy to .env and set POSTGRES_PASSWORD. Never commit .env.

# Postgres service (docker compose)
POSTGRES_USER=facefit
POSTGRES_DB=facefit
POSTGRES_PASSWORD=

# Backend
# Outside compose, set DATABASE_URL. pglite://<dir> runs Postgres in WASM without Docker and keeps
# its files in <dir>, so migrate, seed and the server share one database. Avoid pglite://memory
# for these three commands: each process would get its own empty copy.
DATABASE_URL=pglite://./.data/facefit
# Alternative to DATABASE_URL: the backend builds a URL and encodes the password itself.
# Compose sets POSTGRES_HOST=postgres. POSTGRES_PORT defaults to 5432.
# POSTGRES_HOST=
# Defaults to assets/catalog.json in the repository.
CATALOG_PATH=
PORT=5055
# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Set true only behind one reverse proxy that appends X-Forwarded-For.
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
TELEMETRY_RATE_LIMIT_MAX=30
REQUEST_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=10000
